+# ── validate_mac ──────────────────────────────────────────────────────────────
+
+from manage import validate_mac
+
+def test_validate_mac_valid():
+    """Valid MAC addresses should not exit."""
+    validate_mac("00:11:22:33:44:55")
+    validate_mac("aa:bb:cc:dd:ee:ff")
+    validate_mac("AA:BB:CC:DD:EE:FF")
+    validate_mac("0A:1B:2C:3D:4E:5F")
+    validate_mac(None)
+    validate_mac("")
+
+@patch("manage.console.print")
+def test_validate_mac_invalid(mock_print):
+    """Invalid MAC addresses should cause sys.exit(1)."""
+    invalid_macs = [
+        "00:11:22:33:44",          # Too short
+        "00:11:22:33:44:55:66",    # Too long
+        "00-11-22-33-44-55",       # Wrong delimiter
+        "00:11:22:33:44:ZZ",       # Invalid characters
+        "001122334455",            # No delimiter
+        " : : : : : ",             # Only delimiters
+        "00:11:22:33:44:55 ",      # Trailing space
+        " 00:11:22:33:44:55",      # Leading space
+    ]
+    for mac in invalid_macs:
+        with pytest.raises(SystemExit) as excinfo:
+            validate_mac(mac)
+        assert excinfo.value.code == 1
+        mock_print.assert_called_with(f"[bold red]Error:[/bold red] Invalid MAC address format ({mac}).")
