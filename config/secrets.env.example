PHOTON_ISO_CHECKSUM="sha512:85cddaa8da26c095cf55d3f22f0838ad5d9ae73aa476d0c5c8e54bfbfcb432deaf940733c2cb5af14d1e5b133da65c17f3f4e215bf381d5b8b411d548b66a463"

# Common Build Specs
PACKER_FIRMWARE="bios"
TEMPLATE_CPU_COUNT="2"
TEMPLATE_MEMORY_MB="2048"
TEMPLATE_DISK_SIZE_MB="20480"

# ==========================================================
# 5. ADMIN CREDENTIALS
# ==========================================================
