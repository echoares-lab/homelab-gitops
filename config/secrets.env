# 1Password secret references for homelab-gitops
# Resolved via 1Password Connect at https://{connect-hostname}:8200
# This file is safe to commit to git (only contains references, not secrets).
#
# Usage:
#   export OP_CONNECT_TOKEN=$(cat /etc/op-connect/token)
#   op run --server https://{connect-hostname}:8200 -- python3 manage.py <command>

# ── vCenter Connection (prod) ────────────────────────────────────────────────
VCENTER_SERVER=op://homelab-gitops/prod/VCENTER_SERVER
VCENTER_USERNAME=op://homelab-gitops/prod/VCENTER_USERNAME
VCENTER_PASSWORD=op://homelab-gitops/prod/VCENTER_PASSWORD

# ── vCenter Infrastructure (prod) ────────────────────────────────────────────
VCENTER_DATACENTER=op://homelab-gitops/prod/VCENTER_DATACENTER
VCENTER_CLUSTER=op://homelab-gitops/prod/VCENTER_CLUSTER
VCENTER_DATASTORE=op://homelab-gitops/prod/VCENTER_DATASTORE
VCENTER_NETWORK=op://homelab-gitops/prod/VCENTER_NETWORK

# ── vCenter Folder Hierarchy (prod) ──────────────────────────────────────────
VCENTER_BUILD_FOLDER=op://homelab-gitops/prod/VCENTER_BUILD_FOLDER
VCENTER_TEMPLATE_FOLDER=op://homelab-gitops/prod/VCENTER_TEMPLATE_FOLDER
VCENTER_BUILD_TEST_FOLDER=op://homelab-gitops/prod/VCENTER_BUILD_TEST_FOLDER
VCENTER_DEPLOY_PROD_FOLDER=op://homelab-gitops/prod/VCENTER_DEPLOY_PROD_FOLDER
VCENTER_DEPLOY_TEST_FOLDER=op://homelab-gitops/prod/VCENTER_DEPLOY_TEST_FOLDER

# ── SSH Admin Credentials (prod) ─────────────────────────────────────────────
SSH_ADMIN_USERNAME=op://homelab-gitops/prod/SSH_ADMIN_USERNAME
SSH_ADMIN_PASSWORD=op://homelab-gitops/prod/SSH_ADMIN_PASSWORD
SSH_ADMIN_SSH_PUBKEY=op://homelab-gitops/prod/SSH_ADMIN_SSH_PUBKEY
SSH_PRIVATE_KEY_PATH=op://homelab-gitops/prod/SSH_PRIVATE_KEY_PATH

# ── Content Library (prod) ───────────────────────────────────────────────────
CONTENT_LIBRARY_NAME=op://homelab-gitops/prod/CONTENT_LIBRARY_NAME
CONTENT_LIBRARY_ITEM_NAME=op://homelab-gitops/prod/CONTENT_LIBRARY_ITEM_NAME

# ── Build ISO Sources (prod) ─────────────────────────────────────────────────
UBUNTU_2404_ISO_URL=op://homelab-gitops/prod/UBUNTU_2404_ISO_URL
UBUNTU_2404_ISO_CHECKSUM=op://homelab-gitops/prod/UBUNTU_2404_ISO_CHECKSUM
UBUNTU_2604_ISO_URL=op://homelab-gitops/prod/UBUNTU_2604_ISO_URL
UBUNTU_2604_ISO_CHECKSUM=op://homelab-gitops/prod/UBUNTU_2604_ISO_CHECKSUM
PHOTON_ISO_URL=op://homelab-gitops/prod/PHOTON_ISO_URL
PHOTON_ISO_CHECKSUM=op://homelab-gitops/prod/PHOTON_ISO_CHECKSUM

# ── Packer Build Config (prod) ───────────────────────────────────────────────
PACKER_FIRMWARE=op://homelab-gitops/prod/PACKER_FIRMWARE
TEMPLATE_CPU_COUNT=op://homelab-gitops/prod/TEMPLATE_CPU_COUNT
TEMPLATE_MEMORY_MB=op://homelab-gitops/prod/TEMPLATE_MEMORY_MB
TEMPLATE_DISK_SIZE_MB=op://homelab-gitops/prod/TEMPLATE_DISK_SIZE_MB

# ── Technitium DNS Manager (prod) ────────────────────────────────────────────
TECHNITIUM_HOST=op://homelab-gitops/prod/TECHNITIUM_HOST
TECHNITIUM_TOKEN=op://homelab-gitops/prod/TECHNITIUM_TOKEN
