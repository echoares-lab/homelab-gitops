# 1Password secret references for homelab-gitops
# Resolved via 1Password service account token (OP_SERVICE_ACCOUNT_TOKEN)
# This file is safe to commit to git (only contains references, not secrets).
#
# Usage:
#   op run --env-file=config/secrets.env -- python3 manage.py <command>
# Or set OP_SERVICE_ACCOUNT_TOKEN and manage.py auto-bootstraps.

# ── vCenter Connection (prod) ────────────────────────────────────────────────
VCENTER_SERVER=op://Homelab-GitOps/vCenter/server
VCENTER_USERNAME=op://Homelab-GitOps/vCenter/username
VCENTER_PASSWORD=op://Homelab-GitOps/vCenter/password

# ── vCenter Infrastructure (prod) ────────────────────────────────────────────
VCENTER_DATACENTER=op://Homelab-GitOps/vCenter/datacenter
VCENTER_CLUSTER=op://Homelab-GitOps/vCenter/cluster
VCENTER_DATASTORE=op://Homelab-GitOps/vCenter/datastore
VCENTER_NETWORK=op://Homelab-GitOps/vCenter/network

# ── vCenter Folder Hierarchy (prod) ──────────────────────────────────────────
VCENTER_BUILD_FOLDER=op://Homelab-GitOps/vCenter/build_folder
VCENTER_TEMPLATE_FOLDER=op://Homelab-GitOps/vCenter/template_folder
VCENTER_BUILD_TEST_FOLDER=op://Homelab-GitOps/vCenter/build_test_folder
VCENTER_DEPLOY_PROD_FOLDER=op://Homelab-GitOps/vCenter/deploy_prod_folder
VCENTER_DEPLOY_TEST_FOLDER=op://Homelab-GitOps/vCenter/deploy_test_folder

# ── SSH Admin Credentials (prod) ─────────────────────────────────────────────
SSH_ADMIN_USERNAME=op://Homelab-GitOps/SSH-Admin/username
SSH_ADMIN_PASSWORD=op://Homelab-GitOps/SSH-Admin/password
SSH_ADMIN_SSH_PUBKEY=op://Homelab-GitOps/SSH-Admin/pubkey
SSH_PRIVATE_KEY_PATH=op://Homelab-GitOps/SSH-Admin/key_path

# ── Content Library (prod) ───────────────────────────────────────────────────
CONTENT_LIBRARY_NAME=op://Homelab-GitOps/Content-Library/name
CONTENT_LIBRARY_ITEM_NAME=op://Homelab-GitOps/Content-Library/item_name

# ── Build ISO Sources (prod) ─────────────────────────────────────────────────
UBUNTU_2404_ISO_URL=op://Homelab-GitOps/Build-ISOs/ubuntu_2404_iso_url
UBUNTU_2404_ISO_CHECKSUM=op://Homelab-GitOps/Build-ISOs/ubuntu_2404_iso_checksum
UBUNTU_2604_ISO_URL=op://Homelab-GitOps/Build-ISOs/ubuntu_2604_iso_url
UBUNTU_2604_ISO_CHECKSUM=op://Homelab-GitOps/Build-ISOs/ubuntu_2604_iso_checksum
PHOTON_ISO_URL=op://Homelab-GitOps/Build-ISOs/photon_iso_url
PHOTON_ISO_CHECKSUM=op://Homelab-GitOps/Build-ISOs/photon_iso_checksum

# ── Packer Build Config (prod) ───────────────────────────────────────────────
PACKER_FIRMWARE=op://Homelab-GitOps/Build-Config/packer_firmware
TEMPLATE_CPU_COUNT=op://Homelab-GitOps/Build-Config/template_cpu_count
TEMPLATE_MEMORY_MB=op://Homelab-GitOps/Build-Config/template_memory_mb
TEMPLATE_DISK_SIZE_MB=op://Homelab-GitOps/Build-Config/template_disk_size_mb

# ── Technitium DNS Manager (prod) ────────────────────────────────────────────
TECHNITIUM_HOST=op://Homelab-GitOps/Technitium/host
TECHNITIUM_TOKEN=op://Homelab-GitOps/Technitium/token

# ── OPNsense Firewall (prod) ─────────────────────────────────────────────────
OPNSENSE_URL=op://Homelab-GitOps/OPNsense/url
OPNSENSE_KEY=op://Homelab-GitOps/OPNsense/api_key
OPNSENSE_SECRET=op://Homelab-GitOps/OPNsense/api_secret
