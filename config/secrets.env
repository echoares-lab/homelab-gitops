# 1Password secret references for homelab-gitops
# Resolved via 1Password service account token (OP_SERVICE_ACCOUNT_TOKEN)
# This file is safe to commit to git (only contains references, not secrets).
#
# Usage:
#   op run --env-file=config/secrets.env -- python3 manage.py <command>
# Or set OP_SERVICE_ACCOUNT_TOKEN and manage.py auto-bootstraps.

# ── vCenter Connection (prod) ────────────────────────────────────────────────
VCENTER_SERVER=op://platform-vcenter/vcenter/VCENTER_SERVER
VCENTER_USERNAME=op://platform-vcenter/vcenter/VCENTER_USERNAME
VCENTER_PASSWORD=op://platform-vcenter/vcenter/VCENTER_PASSWORD

# ── vCenter Infrastructure (prod) ────────────────────────────────────────────
VCENTER_DATACENTER=op://platform-vcenter/vcenter/VCENTER_DATACENTER
VCENTER_CLUSTER=op://platform-vcenter/vcenter/VCENTER_CLUSTER
VCENTER_DATASTORE=op://platform-vcenter/vcenter/VCENTER_DATASTORE
VCENTER_NETWORK=op://platform-vcenter/vcenter/VCENTER_NETWORK

# ── vCenter Folder Hierarchy (prod) ──────────────────────────────────────────
VCENTER_BUILD_FOLDER=op://platform-vcenter/vcenter/VCENTER_BUILD_FOLDER
VCENTER_TEMPLATE_FOLDER=op://platform-vcenter/vcenter/VCENTER_TEMPLATE_FOLDER
VCENTER_BUILD_TEST_FOLDER=op://platform-vcenter/vcenter/VCENTER_BUILD_TEST_FOLDER
VCENTER_DEPLOY_PROD_FOLDER=op://platform-vcenter/vcenter/VCENTER_DEPLOY_PROD_FOLDER
VCENTER_DEPLOY_TEST_FOLDER=op://platform-vcenter/vcenter/VCENTER_DEPLOY_TEST_FOLDER

# ── SSH Admin Credentials (prod) ─────────────────────────────────────────────
SSH_ADMIN_USERNAME=op://repo-homelab-gitops/prod/SSH_ADMIN_USERNAME
SSH_ADMIN_PASSWORD=op://repo-homelab-gitops/prod/SSH_ADMIN_PASSWORD
SSH_ADMIN_SSH_PUBKEY=op://repo-homelab-gitops/prod/SSH_ADMIN_SSH_PUBKEY
SSH_PRIVATE_KEY_PATH=op://repo-homelab-gitops/prod/SSH_PRIVATE_KEY_PATH

# ── Content Library (prod) ───────────────────────────────────────────────────
CONTENT_LIBRARY_NAME=op://platform-vcenter/vcenter/CONTENT_LIBRARY_NAME
CONTENT_LIBRARY_ITEM_NAME=op://platform-vcenter/vcenter/CONTENT_LIBRARY_ITEM_NAME

# ── Build ISO Sources (prod) ─────────────────────────────────────────────────
UBUNTU_2404_ISO_URL=op://repo-homelab-gitops/prod/UBUNTU_2404_ISO_URL
UBUNTU_2404_ISO_CHECKSUM=op://repo-homelab-gitops/prod/UBUNTU_2404_ISO_CHECKSUM
UBUNTU_2604_ISO_URL=op://repo-homelab-gitops/prod/UBUNTU_2604_ISO_URL
UBUNTU_2604_ISO_CHECKSUM=op://repo-homelab-gitops/prod/UBUNTU_2604_ISO_CHECKSUM
PHOTON_ISO_URL=op://repo-homelab-gitops/prod/PHOTON_ISO_URL
PHOTON_ISO_CHECKSUM=op://repo-homelab-gitops/prod/PHOTON_ISO_CHECKSUM

# ── Packer Build Config (prod) ───────────────────────────────────────────────
PACKER_FIRMWARE=op://repo-homelab-gitops/prod/PACKER_FIRMWARE
TEMPLATE_CPU_COUNT=op://repo-homelab-gitops/prod/TEMPLATE_CPU_COUNT
TEMPLATE_MEMORY_MB=op://repo-homelab-gitops/prod/TEMPLATE_MEMORY_MB
TEMPLATE_DISK_SIZE_MB=op://repo-homelab-gitops/prod/TEMPLATE_DISK_SIZE_MB

# ── Technitium DNS Manager (prod) ────────────────────────────────────────────
TECHNITIUM_HOST=op://platform-vcenter/technitium/TECHNITIUM_HOST
TECHNITIUM_TOKEN=op://platform-vcenter/technitium/TECHNITIUM_TOKEN

# ── OPNsense Firewall (prod) ─────────────────────────────────────────────────
OPNSENSE_URL=op://platform-vcenter/opnsense/OPNSENSE_URL
OPNSENSE_KEY=op://platform-vcenter/opnsense/OPNSENSE_KEY
OPNSENSE_SECRET=op://platform-vcenter/opnsense/OPNSENSE_SECRET

# GitHub runner/test VM integration
GITHUB_PERSONAL_ACCESS_TOKEN=op://platform-github-runners/github-runners/GITHUB_PERSONAL_ACCESS_TOKEN
# Add these after the CI test VM credentials are available:
# TEST_VM_HOST=op://platform-github-runners/github-runners/TEST_VM_HOST
# TEST_VM_SSH_KEY=op://platform-github-runners/github-runners/TEST_VM_SSH_KEY
