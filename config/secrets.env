# OpenBao secret references for homelab-gitops
# Resolved via bao CLI with VAULT_ADDR and VAULT_TOKEN.
# This file is safe to commit to git (only contains references, not secrets).
#
# Usage:
#   export VAULT_ADDR=http://openbao.plexplease.com:8201
#   python3 manage.py <command>

# ── vCenter Connection (prod) ────────────────────────────────────────────────
VCENTER_SERVER=bao://kv/agents/autonomous/vcenter/prod/VCENTER_SERVER
VCENTER_USERNAME=bao://kv/agents/autonomous/vcenter/prod/VCENTER_USERNAME
VCENTER_PASSWORD=bao://kv/agents/autonomous/vcenter/prod/VCENTER_PASSWORD

# ── vCenter Infrastructure (prod) ────────────────────────────────────────────
VCENTER_DATACENTER=bao://kv/agents/autonomous/vcenter/prod/VCENTER_DATACENTER
VCENTER_CLUSTER=bao://kv/agents/autonomous/vcenter/prod/VCENTER_CLUSTER
VCENTER_DATASTORE=bao://kv/agents/autonomous/vcenter/prod/VCENTER_DATASTORE
VCENTER_NETWORK=bao://kv/agents/autonomous/vcenter/prod/VCENTER_NETWORK

# ── vCenter Folder Hierarchy (prod) ──────────────────────────────────────────
VCENTER_BUILD_FOLDER=bao://kv/agents/autonomous/vcenter/prod/VCENTER_BUILD_FOLDER
VCENTER_TEMPLATE_FOLDER=bao://kv/agents/autonomous/vcenter/prod/VCENTER_TEMPLATE_FOLDER
VCENTER_BUILD_TEST_FOLDER=bao://kv/agents/autonomous/vcenter/prod/VCENTER_BUILD_TEST_FOLDER
