#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  network:
    network:
      version: 2
      ethernets:
        ens192:
          dhcp4: true
  storage:
    layout:
      name: direct
  identity:
    hostname: ubuntu2404-golden-base
    username: ansible
    # Generate with: openssl passwd -6 'yourpassword'
    # Generate with: openssl passwd -6 'yourpassword'
    password: "REPLACE_ME_SHA512_HASH"
  ssh:
    install-server: true
    authorized-keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPttp9ftShk3KFBHJaAq3e+KrH/jpATS7suoNJt4jDAi Generated By Termius
    allow-pw: true
  packages:
    - open-vm-tools
    - python3
    - tar
    - rsync
    - sudo
  late-commands:
    - echo 'ansible ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/ansible
    - chmod 440 /target/etc/sudoers.d/ansible
    - sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /target/etc/ssh/sshd_config
