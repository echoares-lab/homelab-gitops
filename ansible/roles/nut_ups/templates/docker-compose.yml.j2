services:
  nut-upsd:
    image: ghcr.io/tigattack/nut-upsd:latest
    container_name: nut-upsd
    restart: unless-stopped
    ports:
      - "{{ nut_ups_port }}:3493"
    devices:
      - /dev/bus/usb:/dev/bus/usb
    volumes:
      - /opt/nut/config:/etc/nut:ro
    privileged: true

  peanut:
    image: brandawg93/peanut:latest
    container_name: peanut
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - /opt/nut/peanut:/config
    environment:
      - WEB_PORT=8080
      - AUTH_SECRET={{ nut_admin_password | default('Singer4life!@') }}
    depends_on:
      - nut-upsd
