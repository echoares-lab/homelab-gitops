# File: roles/technitium_photon/templates/dns.service.j2
# Purpose: systemd unit template for Technitium DNS Server on Photon OS.
# Usage: Rendered to /etc/systemd/system/{{ technitium_service_name }}.service by the role.
[Unit]
Description=Technitium DNS Server
Documentation=https://technitium.com/dns/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ technitium_service_user }}
Group={{ technitium_service_user }}
WorkingDirectory={{ technitium_app_dir }}
ExecStart=/usr/bin/dotnet {{ technitium_app_dir }}/DnsServerApp.dll /config {{ technitium_config_dir }}
Restart=always
RestartSec=10
SyslogIdentifier=technitium-dns
Environment=DOTNET_ROOT={{ technitium_dotnet_dir }}
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Keep write access explicit. Photon/systemd will still allow normal runtime needs.
ReadWritePaths={{ technitium_app_dir }} {{ technitium_config_dir }} {{ technitium_log_dir }}

[Install]
WantedBy=multi-user.target
