[Unit]
Description=Technitium DNS Cache Heartbeat
After=network.target technitium-dns.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 {{ technitium_app_dir }}/dns_heartbeat.py
Restart=always
RestartSec=10
Environment="TECHNITIUM_HOST=http://127.0.0.1:5380"
Environment="TECHNITIUM_TOKEN={{ lookup('env', 'TECHNITIUM_TOKEN') | default('dummy', true) }}"
Environment="HEARTBEAT_QPS={{ technitium_heartbeat_qps }}"
User={{ technitium_service_user }}

[Install]
WantedBy=multi-user.target
