{
  "ignition": {
    "version": "3.4.0"
  },
  "storage": {
    "files": [
      {
        "path": "/tmp/installed.ign",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 420
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Run coreos-installer\nRequires=coreos-installer-pre.target\nAfter=coreos-installer-pre.target\nOnFailure=emergency.target\nOnFailureJobMode=isolate\n[Service]\nType=oneshot\nExecStart=/usr/bin/coreos-installer install /dev/sda --ignition-file /tmp/installed.ign\nExecStartPost=/usr/bin/systemctl poweroff\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "coreos-installer.service"
      }
    ]
  }
}
