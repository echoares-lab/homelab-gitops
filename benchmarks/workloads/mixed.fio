[global]
ioengine=libaio
direct=1
iodepth=32
numjobs=4
runtime=60
time_based
group_reporting
output_format=json
lat_percentiles=1
percentile_list=50,95,99,100

[mixed-random]
rw=randread
bs=4k
size=5G
name=mixed-random

[mixed-sequential]
rw=rw
bs=128k
rwmixread=50
rwmixwrite=50
size=5G
name=mixed-sequential
