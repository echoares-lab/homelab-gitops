[global]
ioengine=libaio
direct=1
bs=4k
iodepth=32
numjobs=4
runtime=60
time_based
group_reporting
output_format=json
lat_percentiles=1
percentile_list=50,95,99,100

[database-read]
rw=randread
rwmixread=70
size=10G
name=database-70-30

[database-write]
rw=randwrite
rwmixwrite=30
size=10G
name=database-70-30-write
